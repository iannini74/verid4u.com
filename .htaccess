# VerID4U — Hostinger (Apache + CloudLinux)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS (considerando proxy que termina TLS)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Domínio canônico sem www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Arquivos e diretórios reais passam direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto vai para o controlador frontal
  RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"

  # image/svg+xml saiu desta lista de proposito. O selo do emissor e servido
  # como SVG e afirma verificacao ativa: trinta dias de cache fariam o selo de
  # um emissor que saiu do registro continuar dizendo "verificado" por um mes
  # nos sites dele. Dava para excluir so /selo/ com um bloco <If>, mas <If>
  # tem suporte irregular fora do Apache e um erro aqui derruba o site inteiro
  # — nao vale o risco por causa do cache de quatro arquivos de marca, que
  # ETag e Last-Modified ja resolvem.
</IfModule>

# Código de aplicação nunca é servido direto
RedirectMatch 404 ^/(lib|views|i18n|storage|mail|content|tools|docs|\.ds|\.hostinger)(/|$)

# Nada cujo nome comece com _ é servido. É a rede para arquivo temporário
# que sobrou: a API da hospedagem não apaga arquivo avulso, então o nome
# precisa carregar a própria proteção.
<FilesMatch "^_">
  Require all denied
</FilesMatch>

<FilesMatch "\.(md|sql|json|lock|yml|yaml|sh|secret|example\.php|local\.php)$">
  Require all denied
</FilesMatch>
